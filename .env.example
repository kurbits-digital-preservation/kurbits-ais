# Copy to .env and fill in values before running docker-compose

# Required
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL (default profile)
POSTGRES_PASSWORD=kurbits

# Optional overrides
PORT=8080
LOG_LEVEL=info
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# To use SQLite instead of PostgreSQL:
#   docker compose --profile sqlite up
# DATABASE_URL is set automatically per profile.
# To override manually:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname